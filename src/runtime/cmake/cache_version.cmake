# Writes OUT, a header defining DT_SHADER_CACHE_VERSION: a hash of the shader translator's and renderer's sources, so
# that any change to them invalidates the translated-shader and pipeline caches (gpu/renderer.cpp). Run at build time
# by a custom command that depends on those sources; FILES is a ;-separated list. The header is rewritten only when
# the hash changes, so unrelated rebuilds do not recompile its users.
set(text "")
foreach(f IN LISTS FILES)
    file(READ "${f}" content)
    get_filename_component(name "${f}" NAME)
    string(APPEND text "${name}\n${content}\n")
endforeach()
if(NOT NAME)
    set(NAME DT_SHADER_CACHE_VERSION)
endif()
string(APPEND text "${EXTRA}")
string(SHA256 hash "${text}")
string(SUBSTRING "${hash}" 0 16 hash)
set(header "// Generated by cmake/cache_version.cmake: do not edit.\n#pragma once\n#define ${NAME} \"${hash}\"\n")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL header)
    file(WRITE "${OUT}" "${header}")
endif()
